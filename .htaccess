# FINEZZA — producción en HostGator
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
# http -> https (sin tocar la validación de AutoSSL)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# www -> sin www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# La landing ahora es solo de cocinas: /landing.html y /landing-cocinas.html -> /landing-cocinas
RewriteCond %{THE_REQUEST} \s/landing(-cocinas)?\.html[\s?] [NC]
RewriteRule ^ /landing-cocinas [L,R=301]
# /landing-cocinas sirve el archivo landing-cocinas.html
RewriteRule ^landing-cocinas/?$ landing-cocinas.html [L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_headers.c>
# HTML: siempre revalidar para que cada deploy se vea al instante
<FilesMatch "\.html?$">
Header set Cache-Control "no-cache"
</FilesMatch>
# CSS/JS: un mes (se versionan con ?v= en el HTML)
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
# Imágenes, video y fuentes: un año
<FilesMatch "\.(jpe?g|png|webp|avif|gif|svg|ico|mp4|webm|woff2?)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
</IfModule>
